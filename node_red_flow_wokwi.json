  {
    "id": "n14watchfunc001",
    "type": "function",
    "z": "n14tab0000000001",
    "name": "Quá 15 giây → OFFLINE",
    "func": "const now = Date.now();\nlet last = flow.get('lastHeartbeatAt');\nif (!last) { flow.set('lastHeartbeatAt', now); return null; }\nif (now - last > 15000 && !flow.get('deviceOffline')) {\n  flow.set('deviceOffline', true);\n  msg.payload = `OFFLINE — quá ${Math.floor((now-last)/1000)} giây không nhận heartbeat`;\n  return msg;\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
