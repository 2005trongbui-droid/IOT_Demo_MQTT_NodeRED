  {
    "id": "n14histfmt0001",
    "type": "function",
    "z": "n14tab0000000001",
    "name": "Chuẩn bị Data History",
    "func": "const p = msg.payload || {};\nconst token = env.get('INFLUX_TOKEN');\nif (!token) { node.warn('Chưa cấu hình INFLUX_TOKEN; bỏ qua ghi Data History'); return null; }\n\nconst result = String(p.result || '').toUpperCase();\nconst h = Number(p.height_cm);\nconst d = Number(p.distance_cm);\nconst sampleId = String(p.sample_id || '');\nconst validProduct = (result === 'PASS' || result === 'REJECT') &&\n    Number.isFinite(h) && h >= 0 && h <= 20 &&\n    Number.isFinite(d) && d >= 2 && d <= 20 && sampleId.length > 0;\nif (!validProduct) return null;\n\n// Heartbeat/status is separate: persist each classified product only once.\nif (flow.get('lastSavedSampleId') === sampleId) return null;\nflow.set('lastSavedSampleId', sampleId);\n\nconst fields = [];\nfor (const k of ['distance_cm','height_cm','total','pass','reject','measure_error','reject_rate']) {\n    const v = Number(p[k]);\n    if (Number.isFinite(v)) fields.push(k + '=' + v);\n}\nconst quote = value => '\"' + String(value).replace(/\"/g, '') + '\"';\nif (typeof p.enabled === 'boolean') fields.push('enabled=' + (p.enabled ? 1 : 0));\nfields.push('result=' + quote(result));\nfields.push('reason=' + quote(String(p.reason || '')));\nfields.push('sample_id=' + quote(sampleId));\n\nmsg.headers = { Authorization: 'Token ' + token, 'Content-Type': 'text/plain; charset=utf-8' };\nmsg.payload = 'conveyor,device=esp32-conveyor-nhom14 ' + fields.join(',') + ' ' + Date.now();\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 580,
    "y": 180,
    "wires": [
      [
        "n14influxhttp01"
      ]
    ]
  },
  {
    "id": "n14influxhttp01",
    "type": "http request",
    "z": "n14tab0000000001",
    "name": "Ghi InfluxDB Data History",
    "method": "POST",
