  {
    "id": "n14fmtstatus001",
    "type": "function",
    "z": "n14tab0000000001",
    "name": "Trạng thái ESP32",
    "func": "const p = msg.payload || {};\nconst state = p.state || 'UNKNOWN';\nconst text = state + (p.message ? ' — ' + p.message : '');\nconst counts = 'Tổng: ' + (p.total ?? 0) + ' | PASS: ' + (p.pass ?? 0) +\n    ' | REJECT: ' + (p.reject ?? 0) + ' | Lỗi đo: ' + (p.measure_error ?? 0);\nconst statusMessage = {...msg, payload: text};\nconst historyMessage = {...msg, payload: {state, message: p.message || '', enabled: p.enabled === true}};\nconst countsMessage = {payload: counts};\nreturn [statusMessage, historyMessage, countsMessage];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
