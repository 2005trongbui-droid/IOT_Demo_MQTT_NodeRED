  {
    "id": "n14fmt000000001",
    "type": "function",
    "z": "n14tab0000000001",
    "name": "Tách dữ liệu hiển thị",
    "func": "const p = msg.payload || {};\nconst result = String(p.result || 'NONE').toUpperCase();\nconst reason = String(p.reason || '');\nconst h = Number(p.height_cm);\nconst d = Number(p.distance_cm);\nconst validProduct = (result === 'PASS' || result === 'REJECT') &&\n    Number.isFinite(h) && h >= 0 && h <= 20 &&\n    Number.isFinite(d) && d >= 2 && d <= 20;\nconst counts = 'Tổng: ' + (p.total ?? 0) + ' | PASS: ' + (p.pass ?? 0) +\n    ' | REJECT: ' + (p.reject ?? 0) + ' | Lỗi đo: ' + (p.measure_error ?? 0);\n\nif (!validProduct) {\n    let label = 'Bản tin không hợp lệ — đã bỏ khỏi biểu đồ';\n    if (result === 'BOOT' || reason === 'BOOT') label = 'Khởi động — chưa có sản phẩm';\n    else if (reason === 'NO_PRODUCT') label = 'Không có sản phẩm trong vùng đo';\n    else if (result === 'MEASURE_ERROR') label = 'Lỗi đo: ' + reason + ' — không vẽ lên biểu đồ';\n    else if (result === 'NONE') label = 'Chưa có sản phẩm';\n    return [null, {payload: label}, {payload: counts}, null];\n}\n\nconst sampleId = String(p.sample_id || 'chưa có mã');\nreturn [\n    {payload: h},\n    {payload: result + ' — ' + reason + ' | Mã mẫu: ' + sampleId},\n    {payload: counts},\n    {topic: 'Chiều cao (cm)', payload: h, timestamp: Date.now()}\n];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 570,
    "y": 80,
    "wires": [
      [
        "n14gauge0000001"
      ],
      [
        "n14result000001"
      ],
      [
        "n14stats0000001"
      ],
      [
        "n14chart0000001"
      ]
    ]
  },
